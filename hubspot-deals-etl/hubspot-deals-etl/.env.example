# -- HubSpot API --------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TIMEOUT=30
HUBSPOT_RATE_LIMIT_REQUESTS=150
HUBSPOT_RATE_LIMIT_WINDOW_SECONDS=10

# -- Pipeline / DLT -----------------------------------------------------------
PIPELINE_NAME=hubspot_deals
DB_SCHEMA=hubspot_deals
CHECKPOINT_EVERY_N_PAGES=5

# -- Database (PostgreSQL) ----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_deals_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/hubspot_deals_db

# -- Service ------------------------------------------------------------------
SERVICE_API_KEY=your_service_api_key_here
DEV_PORT=5200
STAGE_PORT=5201
PROD_PORT=5202
ENVIRONMENT=development

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
